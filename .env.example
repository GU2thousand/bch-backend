# Core database connections
DEPLOYED_DATABASE_URL=
MONGO_URI=

# JWT / app config
JWT_SECRET=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAILERLITE_TOKEN=

# Optional: load missing values from AWS Secrets Manager at startup
AWS_REGION=us-east-2
AWS_SECRETS_MANAGER_SECRET_ID=
SKIP_SCHEMA_SYNC=

# Optional: SES credentials for marketplace verification emails
BITCOIN_AWS_ACCESS_KEY=
BITCOIN_AWS_SECRET_ACCESS_KEY=

# Optional: marketplace verification email settings
MARKETPLACE_FRONTEND_URL=http://localhost:8080
MARKETPLACE_VERIFICATION_FROM_EMAIL=
MARKETPLACE_VERIFICATION_FROM_NAME=Bitcoin Culture Hub
MARKETPLACE_VERIFICATION_TTL_MINUTES=15
MARKETPLACE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
